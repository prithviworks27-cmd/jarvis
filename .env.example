# Free key from https://console.groq.com (no card needed)
GROQ_API_KEY=

# Optional
# JARVIS_USER_NAME=sir
# JARVIS_VOCAB=Rishabh, Suryansh, Ritika   (names Whisper often mishears: contacts, apps)
# JARVIS_CITY=Bengaluru   (default for "what is the weather")
# JARVIS_TTS_VOICE=troy
# JARVIS_KOKORO_VOICE=bm_george
# JARVIS_TTS=kokoro   (offline voice only; no daily limit. "say" = macOS voice only)
# JARVIS_STT_LANGUAGE=en   (force one language for speech recognition; default is automatic English/Hindi/Hinglish)
# JARVIS_HINDI_VOICE=Lekha   (macOS voice for Hindi replies)
# JARVIS_VOICE=Daniel   (macOS fallback voice)
# JARVIS_CONTROL_APPS=Google Chrome,Safari,WhatsApp,Spotify,Music,Notes   (apps JARVIS may type/click in)
# JARVIS_HOTKEY=Alt+Space
# JARVIS_MODEL=openai/gpt-oss-120b
# JARVIS_VISION_MODEL=qwen/qwen3.8-27b   (used for "look at my screen")
# JARVIS_FALLBACK_MODEL=openai/gpt-oss-20b   (used when the main model is rate-limited)
